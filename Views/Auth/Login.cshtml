<p class="auth-links"><a href="/Auth/Recuperar">¿Olvidaste tu contraseña?</a><a href="/Auth/Registro">¿No tenés cuenta? <strong>Registrate acá</strong></a></p>
@section Scripts { <script src="~/js/login.js"></script> }

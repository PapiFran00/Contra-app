@{ ViewData["Title"] = "Inicio"; }
@if (ViewBag.Nombre is not null) { <header class="page-heading"><p class="page-kicker">TU PRÓXIMO PARTIDO EMPIEZA ACÁ</p><h1>Hola de nuevo, @ViewBag.Nombre</h1><p>¿Listo para encontrar tu próximo partido?</p></header> }
else { <header class="page-heading"><p class="page-kicker">FÚTBOL Y PÁDEL, CERCA TUYO</p><h1>Jugá tu próximo partido</h1><p>Encontrá gente, cancha y el horario ideal.</p></header> }
<section class="dashboard"><div class="metric"><b id="metric-organizados">—</b><span>Organizados</span></div><div class="metric"><b id="metric-contra">—</b><span>Con Contra</span></div><div class="metric"><b id="metric-solicitudes">—</b><span>Solicitudes</span></div></section><h2 class="eyebrow">ACCESOS RÁPIDOS</h2><section class="quick-actions"><a href="/Partidos/Crear"><i>＋</i><b>Crear partido</b></a><a href="/Partidos/Buscar"><i>⚽</i><b>Buscar partido</b></a><a href="/Chat"><i>◯</i><b>Mis chats</b></a><a href="/Perfil"><i>♙</i><b>Mi perfil</b></a></section><section class="community-actions" aria-label="Participá en Contra"><button type="button" data-modal-open="complejo"><i>⌂</i><span><b>Solicitar mi App</b><strong>Unir mi Complejo</strong><small>Contanos sobre tus canchas y te contactamos.</small></span><em aria-hidden="true">›</em></button><button type="button" data-modal-open="opinion"><i>✦</i><span><b>Comunidad CONTRA</b><strong>Dejar opinión</strong><small>Reportá un error o proponé una mejora.</small></span><em aria-hidden="true">›</em></button></section><section class="home-feed"><h2>Próximos partidos</h2><section id="partidos-inicio" class="stack" aria-live="polite"></section></section><dialog id="modal-complejo" class="app-modal"><form id="solicitud-complejo" class="stack"><header><p class="page-kicker">PARA COMPLEJOS</p><h2>Uní tu complejo</h2><p>Dejanos estos datos y nos comunicamos con vos.</p></header><label>Nombre del complejo<input name="nombreComplejo" autocomplete="organization" required /></label><label>Teléfono de contacto<input name="telefono" type="tel" autocomplete="tel" required /></label><div class="sport-request"><label class="check"><input name="tieneFutbol" type="checkbox" /> Tiene canchas de fútbol</label><label>Cantidad de canchas<input name="canchasFutbol" type="number" min="0" value="0" /></label><label class="check"><input name="futbolTechada" type="checkbox" /> Alguna es techada</label></div><div class="sport-request"><label class="check"><input name="tienePadel" type="checkbox" /> Tiene canchas de pádel</label><label>Cantidad de canchas<input name="canchasPadel" type="number" min="0" value="0" /></label><label class="check"><input name="padelTechada" type="checkbox" /> Alguna es techada</label></div><button class="button">Enviar solicitud</button><button type="button" class="text-button" data-modal-close>Cancelar</button><p class="feedback" aria-live="polite"></p></form></dialog><dialog id="modal-opinion" class="app-modal"><form id="opinion-form" class="stack"><header><p class="page-kicker">COMUNIDAD CONTRA</p><h2>Tu opinión importa</h2><p>Ayudanos a mejorar cada partido.</p></header><label>¿Sobre qué querés escribir?<select name="tipo"><option>Opinión</option><option>Error</option><option>Mejora</option></select></label><label>Mensaje<textarea name="mensaje" maxlength="2000" required placeholder="Contanos qué pensás o qué podemos mejorar"></textarea></label><button class="button">Enviar comentario</button><button type="button" class="text-button" data-modal-close>Cancelar</button><p class="feedback" aria-live="polite"></p></form></dialog><template id="partido-card"><article class="card"><strong class="deporte"></strong><p class="fecha"></p><p class="detalle"></p><a class="button" href="/Partidos/Buscar">Ver partido</a></article></template>
@section Scripts { <script src="~/js/home-inicio.js"></script> }
